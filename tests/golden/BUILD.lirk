# Golden reference data, one directory per suite under data/, each
# declared as a directory so adding or editing a golden file invalidates
# exactly the targets that read that suite (not every golden test).

[[target]]
name = "physics_cases"
deps = ["//physics:orbits", "//physics:simulate"]
type = "library"
srcs = ["physics_cases.py"]
data = ["data/physics"]

[[target]]
name = "chaos_cases"
deps = ["//chaos:logistic", "//chaos:lorenz", "//chaos:lyapunov"]
type = "library"
srcs = ["chaos_cases.py"]
data = ["data/chaos"]

[[target]]
name = "agent_cases"
deps = ["//env:training"]
type = "library"
srcs = ["agent_cases.py"]
data = ["data/agents"]

[[target]]
name = "regen"
deps = [":agent_cases", ":chaos_cases", ":physics_cases"]
type = "library"
srcs = ["regen.py"]

[[target]]
name = "physics_golden_test"
type = "test"
runner = "pytest"
srcs = ["test_physics_golden.py"]
deps = [":physics_cases"]
data = ["data/physics"]
timeout = 120

[[target]]
name = "chaos_golden_test"
deps = [":chaos_cases"]
type = "test"
runner = "pytest"
srcs = ["test_chaos_golden.py"]
data = ["data/chaos"]
timeout = 180

[[target]]
name = "agent_golden_test"
deps = [":agent_cases"]
type = "test"
runner = "pytest"
srcs = ["test_agent_golden.py"]
data = ["data/agents"]
timeout = 120

[[target]]
name = "regen_test"
deps = [":regen"]
type = "test"
runner = "pytest"
srcs = ["test_regen.py"]
timeout = 120
