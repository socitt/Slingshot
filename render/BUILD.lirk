# Terminal output: plain-text plots now, replay of agents later.

[[target]]
name = "canvas"
type = "library"
srcs = ["canvas.py"]

[[target]]
name = "canvas_test"
deps = [":canvas"]
type = "test"
runner = "pytest"
srcs = ["test_canvas.py"]

[[target]]
name = "replay"
deps = [":canvas"]
type = "library"
srcs = ["replay.py"]

[[target]]
name = "replay_test"
deps = ["//env:navigation", ":replay"]
type = "test"
runner = "pytest"
srcs = ["test_replay.py"]
timeout = 60

[[target]]
name = "vizdata"
type = "library"
srcs = ["vizdata.py"]
# reads golden agents and chaos numbers at runtime: depend on their owners
deps = ["//tests/golden:agent_cases", "//tests/golden:chaos_cases"]

[[target]]
name = "vizdata_test"
type = "test"
runner = "pytest"
srcs = ["test_vizdata.py"]
deps = [":vizdata"]
timeout = 300
