# Terminal output: plain-text plots now, replay of agents later.

[[target]]
name = "canvas"
type = "library"
srcs = ["canvas.py"]

[[target]]
name = "canvas_test"
deps = [":canvas"]
type = "test"
runner = "pytest"
srcs = ["test_canvas.py"]

[[target]]
name = "replay"
deps = [":canvas"]
type = "library"
srcs = ["replay.py"]

[[target]]
name = "replay_test"
deps = ["//env:navigation", ":replay"]
type = "test"
runner = "pytest"
srcs = ["test_replay.py"]
timeout = 60
