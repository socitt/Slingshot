# The navigation task, genome->policy glue, and the training loop.

[[target]]
name = "navigation"
deps = ["//physics:gravity", "//physics:integrators", "//physics:orbits"]
type = "library"
srcs = ["navigation.py"]

[[target]]
name = "agent"
deps = [":navigation", "//nn:mlp"]
type = "library"
srcs = ["agent.py"]

[[target]]
name = "training"
deps = [":agent", "//evolve:strategies", ":backend"]
type = "library"
srcs = ["training.py"]

[[target]]
name = "navigation_test"
deps = [":navigation", "//physics:orbits"]
type = "test"
runner = "pytest"
srcs = ["test_navigation.py"]
timeout = 60

[[target]]
name = "trio_test"
deps = [":navigation", "//physics:simulate"]
type = "test"
runner = "pytest"
srcs = ["test_trio.py"]
timeout = 120

[[target]]
name = "backend"
deps = [":agent", "//npbackend:batch"]
type = "library"
srcs = ["backend.py"]

[[target]]
name = "backend_test"
deps = [":backend"]
type = "test"
runner = "pytest"
srcs = ["test_backend.py"]

[[target]]
name = "rendezvous_test"
type = "test"
runner = "pytest"
srcs = ["test_rendezvous.py"]
deps = [":navigation"]
timeout = 120

[[target]]
name = "tour_test"
type = "test"
runner = "pytest"
srcs = ["test_tour.py"]
deps = [":agent"]
timeout = 180
