# Entry points. Each is covered by a test target that runs it as a
# subprocess (lirk has no binary target type by design).

[[target]]
name = "chaos_demo"
deps = ["//chaos:logistic", "//chaos:lorenz", "//chaos:lyapunov", "//physics:orbits", "//render:canvas"]
type = "library"
srcs = ["chaos_demo.py"]

[[target]]
name = "chaos_demo_test"
type = "test"
runner = "pytest"
srcs = ["test_chaos_demo.py"]
# Runs `python3 -m cli.chaos_demo` in a subprocess, which lirk's import
# check cannot see -- this dep must be declared by hand (lirk-notes #9).
deps = [":chaos_demo"]
timeout = 300

[[target]]
name = "train"
deps = ["//env:navigation", "//env:training", "//evolve:strategies", "//env:agent"]
type = "library"
srcs = ["train.py"]

[[target]]
name = "train_test"
type = "test"
runner = "pytest"
srcs = ["test_train.py"]
# Subprocess-only, like chaos_demo_test: declared by hand (lirk-notes #9).
deps = [":train"]
timeout = 300

[[target]]
name = "replay"
deps = ["//env:training", "//render:canvas", "//render:replay"]
type = "library"
srcs = ["replay.py"]

[[target]]
name = "replay_cli_test"
type = "test"
runner = "pytest"
srcs = ["test_replay_cli.py"]
# Subprocess-only (lirk-notes #9). The replay also reads the golden
# agents at runtime, so their target is a dep too.
deps = [":replay", "//tests/golden:agent_cases"]
timeout = 120
